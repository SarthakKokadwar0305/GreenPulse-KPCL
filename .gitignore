# ==============================================================================
# GreenPulse AI - Root .gitignore
# ==============================================================================

# Python Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Testing & Code Analysis
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js & Frontend Build Outputs
.next/
out/
build/
dist/

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Logs & Diagnostics
logs/
*.log

# Build Cache & Temporary Scratch
*.tsbuildinfo
.snowflake/
.design-cache/
.v0-trash/
.vercel/
