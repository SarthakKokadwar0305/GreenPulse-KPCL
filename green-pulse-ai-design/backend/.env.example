# GreenPulse AI Backend Environment Configuration

# Application
APP_NAME=GreenPulse AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=greenpulse-enterprise-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite for local rapid development
DATABASE_URL=sqlite+aiosqlite:///./greenpulse.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/greenpulse_db
DB_ECHO=False

# Datasets and Models
DATASET_DIR=./datasets
TRAINED_MODELS_DIR=./trained_models

# Industrial IoT / SCADA Configuration
PLANT_CODE=FAC-IND-PUN-004
CONTRACTED_PEAK_DEMAND_KW=2500
BASE_TARIFF_INR=7.20
PEAK_TARIFF_MULTIPLIER=1.44
GRID_EMISSION_FACTOR_KG_KWH=0.82

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
